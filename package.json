{
  "name": "supscenario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix pfe-backend/pfe_backend run start:dev",
    "dev:frontend": "npm --prefix pfe-frontend/pfe run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix pfe-backend/pfe_backend run build",
    "build:frontend": "npm --prefix pfe-frontend/pfe run build",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm --prefix pfe-backend/pfe_backend run lint",
    "lint:frontend": "npm --prefix pfe-frontend/pfe run lint",
    "test": "npm --prefix pfe-backend/pfe_backend run test -- --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.91.0"
  }
}
