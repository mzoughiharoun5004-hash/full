# ==============================================================================
# SupScenario Production Environment Variables (Cloudflare Tunnel Edition)
# Copy to .env.production before launching Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Tunnel Configuration
# ------------------------------------------------------------------------------
# Default: Quick Tunnel (free, no account needed, logs trycloudflare.com URL)
CLOUDFLARE_TUNNEL_ARGS=tunnel --url http://nginx:80

# To use a permanent Cloudflare Zero Trust domain with a Token:
# CLOUDFLARE_TUNNEL_ARGS=tunnel --no-autoupdate run --token YOUR_CLOUDFLARE_TOKEN_HERE

# Public API URL. Leave as the relative `/api` so the frontend always calls
# back through nginx on whatever origin is currently serving the page -
# works whether that's this session's trycloudflare.com URL or, later, a
# custom domain. Only replace with a full https:// URL if the backend is
# ever split onto a different origin from the frontend.
NEXT_PUBLIC_API_URL=/api
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=supscenario_db
POSTGRES_USER=supscenario_user
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password_123456

# ------------------------------------------------------------------------------
# 3. Cache & Bus (Redis 7)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=change_this_to_a_secure_redis_password_123456

# ------------------------------------------------------------------------------
# 4. Cryptographic Security
# ------------------------------------------------------------------------------
# High-entropy JWT Secret (minimum 32 characters, recommended 64-char hex)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_character_hex_random_cryptographic_secret_here

# ------------------------------------------------------------------------------
# 5. Pedagogical AI & Media Services
# ------------------------------------------------------------------------------
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_groq_production_api_key_here
PEXELS_API_KEY=your_pexels_production_api_key_here

# ------------------------------------------------------------------------------
# 6. SCORM Preview & PDF Maintenance
# ------------------------------------------------------------------------------
SCORM_UPLOAD_TTL_HOURS=24
SCORM_CLEANUP_INTERVAL_MINUTES=60
