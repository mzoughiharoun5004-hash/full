NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/pfe_db
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
JWT_EXPIRES=24h
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
GROQ_API_KEY=replace-with-your-groq-api-key
PEXELS_API_KEY=replace-with-your-pexels-api-key
